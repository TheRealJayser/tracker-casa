rules_version = '2';

// Regole di sicurezza di Tracker Casa.
// Solo gli account presenti nella raccolta "members" (id documento = email) possono leggere/scrivere.
// Solo chi ha role == "admin" gestisce membri, coinquiline e prodotti.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberPath());
    }
    function isAdmin() {
      return isMember() && get(memberPath()).data.role == "admin";
    }

    match /members/{email} {
      allow read: if isMember() || (signedIn() && myEmail() == email);
      allow write: if isAdmin();
    }

    // Richieste di accesso: chi entra con Google e non è ancora autorizzato lascia qui la richiesta
    match /requests/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if signedIn() && myEmail() == email;
      allow delete: if isAdmin() || (signedIn() && myEmail() == email);
    }

    match /people/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /purchases/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.productId is string
        && request.resource.data.personId is string;
      allow update, delete: if isAdmin()
        || (isMember() && resource.data.createdBy == myEmail());
    }

    // Lista "manca in casa": id documento = id prodotto
    match /missing/{productId} {
      allow read, write: if isMember();
    }
  }
}
